<Window x:Class="AfterDark.Studio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="After Dark Studio" Width="1100" Height="700"
        MinWidth="820" MinHeight="560"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="18,14" BorderThickness="0,0,0,1"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource HeaderText}" Text="After Dark Studio" />
          <TextBlock Style="{StaticResource MutedText}" Text="{Binding InstallPath}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Import from disc" Padding="12,6" Margin="0,0,10,0"
                  Click="OnImportModules" />
          <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                     Text="{Binding CountLine}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="330,*">
      <Border Grid.Column="0" BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Margin="14,14,14,10">
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search modules" AutomationProperties.Name="Search modules" />
            <CheckBox IsChecked="{Binding RunnableOnly}" Content="Runnable only"
                      FontSize="12" Margin="0,8,0,0" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Visible}"
                   SelectedItem="{Binding Selected, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent" Padding="8,0,8,10">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="2,6">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource MutedText}"
                               FontSize="11" Margin="0,2,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{Binding BadgeColor}"
                          CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                               Foreground="#12131A" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasModules, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel DataContext="{Binding Selected}">
            <TextBlock Style="{StaticResource HeaderText}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Credits}"
                       TextWrapping="Wrap" Margin="0,4,0,16" />

            <Border Style="{StaticResource CardBorder}" Height="260" ClipToBounds="True">
              <Grid Background="Black">
                <Image x:Name="PreviewImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <StackPanel x:Name="PreviewMessage" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                  <TextBlock Text="▶" FontSize="30" HorizontalAlignment="Center"
                             Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                  <TextBlock x:Name="PreviewMessageText" Style="{StaticResource MutedText}"
                             HorizontalAlignment="Center" TextWrapping="Wrap"
                             MaxWidth="380" TextAlignment="Center" Margin="0,6,0,0"
                             Text="Starting preview…" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,16,0,0"
                    BorderBrush="{StaticResource Warn}"
                    Visibility="{Binding CannotRun, Converter={StaticResource BooleanToVisibility}}">
              <StackPanel>
                <TextBlock Text="This module cannot run on 64-bit Windows"
                           Foreground="{StaticResource Warn}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="It is a 16-bit NE binary. No 64-bit Windows can load it in any process. Its settings are still readable, so a native rewrite can honour them exactly." />
              </StackPanel>
            </Border>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding HasControls, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Style="{StaticResource SectionText}" Text="SETTINGS" Margin="0,0,0,10" />
              <ItemsControl ItemsSource="{Binding Controls}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="180,*,90">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                  Visibility="{Binding IsChoice, Converter={StaticResource BooleanToVisibility}}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsToggle, Converter={StaticResource BooleanToVisibility}}" />
                        <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                Value="{Binding Number, Mode=TwoWay}" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Visibility="{Binding IsNumber, Converter={StaticResource BooleanToVisibility}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,16,0,0"
                    Visibility="{Binding HasNoControls, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Style="{StaticResource MutedText}"
                         Text="This module exposes no configurable settings." />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding HasNoModules, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Style="{StaticResource HeaderText}" Text="Bring your After Dark collection"
                     TextAlignment="Center" />
          <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap"
                     Margin="0,8,0,0"
                     Text="Import from your mounted After Dark disc or an existing installation. Your source files stay untouched." />
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Padding="18,12" BorderThickness="0,1,0,0"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button Grid.Column="0" Content="Windows screensaver settings" Padding="12,6"
                ToolTip="Windows controls the timeout and sign-in-on-resume settings."
                Click="OnOpenScreenSaverSettings" />
        <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                   Margin="18,0" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
        <CheckBox Grid.Column="2" IsChecked="{Binding ApplyToAllUsers}"
                  IsEnabled="{Binding CanApplyToAllUsers}" Content="Default for all users"
                  Margin="0,0,14,0" VerticalAlignment="Center"
                  ToolTip="Publishes this module and its settings as the machine-wide default. Needs administrator rights." />
        <Button Grid.Column="3" Content="Set as screensaver" Padding="16,7"
                FontWeight="SemiBold" Foreground="White"
                Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                IsEnabled="{Binding CanSetScreenSaver}" Click="OnSetScreenSaver" />
      </Grid>
    </Border>
  </Grid>
</Window>